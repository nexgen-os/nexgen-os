{
  "name": "nexgen-os-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "A world model for energy assets — organisations, projects, participants, their meters, devices and series — and the open source operating system built on it, driven by AI agents that work as users of the model.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspaces --if-present",
    "release:check": "node scripts/check-trusted-publishing.mjs",
    "release:publish": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-postgis": "0.2.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "22.20.5",
    "ekwo-os": "0.16.0",
    "hyparquet": "1.31.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "workspaces": [
    "packages/formats/*",
    "packages/core",
    "packages/connectors/*",
    "packages/cli",
    "packages/mcp"
  ]
}
