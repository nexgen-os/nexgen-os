{
  "name": "nexgen-os-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "An open foundation for describing places, buildings and the things in them \u2014 in 3D, over time \u2014 so that energy, architecture and compliance tools can share one model.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run build -w @nexgen-os/core && npm run build --workspaces --if-present",
    "release:check": "node scripts/check-trusted-publishing.mjs",
    "release:publish": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-postgis": "0.2.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "22.20.5",
    "hyparquet": "1.31.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "workspaces": [
    "packages/cli",
    "packages/core",
    "packages/formats/*",
    "packages/connectors/*"
  ]
}
