#65=IFCPROPERTYSET('DaB1cD2eF3gH4iJ5kL6mN7',$,'Pset_BuildingStoreyCommon',$,(#64));
#66=IFCRELDEFINESBYPROPERTIES('EaB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#24,#26),#65);
#67=IFCPROPERTYSINGLEVALUE('FloorFinish',$,IFCLABEL('Oak parquet'),$);
#68=IFCPROPERTYSET('FaB1cD2eF3gH4iJ5kL6mN7',$,'Pset_SpaceCoveringRequirements',$,(#67));
