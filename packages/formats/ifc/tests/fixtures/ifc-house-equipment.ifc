/* Equipment: PV on the roof, a battery with its maker, a meter, an air handler no single device type names, a turbine in the garden. */
#100=IFCSOLARDEVICE('0Eq1Pv2Ab3Cd4Ef5Gh6Ij7',$,'Roof array',$,$,#81,$,$,.SOLARPANEL.);
#101=IFCELECTRICFLOWSTORAGEDEVICE('0Eq1Bt2Ab3Cd4Ef5Gh6Ij7',$,'Home battery',$,$,#110,$,$,.BATTERY.);
#102=IFCUNITARYEQUIPMENT('0Eq1Ah2Ab3Cd4Ef5Gh6Ij7',$,'Ventilation unit',$,$,#25,$,$,.AIRHANDLER.);
#103=IFCFLOWMETER('0Eq1Mt2Ab3Cd4Ef5Gh6Ij7',$,'Electricity meter',$,$,#25,$,$,.ENERGYMETER.);
#104=IFCELECTRICGENERATOR('0Eq1Wt2Ab3Cd4Ef5Gh6Ij7',$,'Garden turbine',$,$,#91,$,$,.USERDEFINED.);
#105=IFCRELCONTAINEDINSPATIALSTRUCTURE('KaB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#101,#102,#103),#24);
#106=IFCRELCONTAINEDINSPATIALSTRUCTURE('LaB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#100),#26);
