/* Three spaces: two on the ground floor with a net floor area, one upstairs with only a gross area. */
#40=IFCSPACE('0Lv1Rm2Kt3Ws4Xy5Za6Bc7',$,'0.01',$,$,#25,$,'Living room',.ELEMENT.,.INTERNAL.,$);
#41=IFCSPACE('0Lv1Rm2Kt3Ws4Xy5Za6Bc8',$,'0.02',$,$,#25,$,'Kitchen',.ELEMENT.,.INTERNAL.,$);
#42=IFCSPACE('0Lv1Rm2Kt3Ws4Xy5Za6Bc9',$,'1.01',$,$,#28,$,$,.ELEMENT.,.INTERNAL.,$);
