#88=IFCRELCONTAINEDINSPATIALSTRUCTURE('IaB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#80),#26);
/* A tree in the garden: no place in the core, counted as skipped. */
#90=IFCGEOGRAPHICELEMENT('0Tr1Ee2Ab3Cd4Ef5Gh6Ij7',$,'Lime tree',$,'tree',#91,$,$,.USERDEFINED.);
