/* Property sets: the building's year of construction and a heritage flag, a storey's use, a space's finish. */
#60=IFCPROPERTYSINGLEVALUE('YearOfConstruction',$,IFCLABEL('1962'),$);
#61=IFCPROPERTYSINGLEVALUE('IsLandmarked',$,IFCLOGICAL(.T.),$);
