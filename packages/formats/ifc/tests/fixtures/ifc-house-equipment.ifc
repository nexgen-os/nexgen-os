#49=IFCQUANTITYAREA('NetFloorArea',$,$,18.,$);
#50=IFCELEMENTQUANTITY('7aB1cD2eF3gH4iJ5kL6mN7',$,'Qto_SpaceBaseQuantities',$,$,(#49));
