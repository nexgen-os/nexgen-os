/* Site, building, two storeys at 0 m and 3 m. */
#20=IFCSITE('1xS3BCk291UvhgP2dvNsgp',$,'Plot',$,$,#21,$,$,.ELEMENT.,$,$,$,$,$);
#21=IFCLOCALPLACEMENT($,#9);
#22=IFCBUILDING('0K7w7JWBL5QOdBzu3Yz7Tq',$,'Canal house','A narrow house on a canal',$,#23,$,'Het Grachtenhuis',.ELEMENT.,0.,$,$);
#23=IFCLOCALPLACEMENT(#21,#9);
#24=IFCBUILDINGSTOREY('3Tq9Gb8Hz7Rf2cW0aLmPkS',$,'00 Ground floor',$,$,#25,$,'Begane grond',.ELEMENT.,0.);
#25=IFCLOCALPLACEMENT(#23,#9);
#26=IFCBUILDINGSTOREY('1Nc4Tf6Uy0Hd8bQ2eVwXrJ',$,'01 First floor',$,$,#28,$,'Eerste verdieping',.ELEMENT.,3.);
#27=IFCAXIS2PLACEMENT3D(#29,$,$);
