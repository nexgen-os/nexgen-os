DATA;
/* Project, units in metres, model context with its map conversion to RD New, X axis 30 degrees counter-clockwise from grid east. */
#1=IFCPROJECT('2HfKnNa8n0FwQvE3VQ6bdu',$,'Canal house',$,$,$,$,(#11),#5);
#2=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#3=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#4=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
