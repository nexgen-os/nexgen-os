#32=IFCRELAGGREGATES('2bB1cD2eF3gH4iJ5kL6mN7',$,$,$,#22,(#24,#26));
/* The same three spaces; areas stay in square metres, the project's area unit. */
#40=IFCSPACE('0Lv1Rm2Kt3Ws4Xy5Za6Bd7',$,'0.01',$,$,#25,$,'Living room',.ELEMENT.,.INTERNAL.,$);
#41=IFCSPACE('0Lv1Rm2Kt3Ws4Xy5Za6Bd8',$,'0.02',$,$,#25,$,'Kitchen',.ELEMENT.,.INTERNAL.,$);
#42=IFCSPACE('0Lv1Rm2Kt3Ws4Xy5Za6Bd9',$,'1.01',$,$,#28,$,$,.ELEMENT.,.INTERNAL.,$);
#43=IFCRELAGGREGATES('3bB1cD2eF3gH4iJ5kL6mN7',$,$,$,#24,(#40,#41));
#44=IFCRELAGGREGATES('4bB1cD2eF3gH4iJ5kL6mN7',$,$,$,#26,(#42));
#45=IFCQUANTITYAREA('NetFloorArea',$,$,32.5,$);
#47=IFCELEMENTQUANTITY('5bB1cD2eF3gH4iJ5kL6mN7',$,'Qto_SpaceBaseQuantities',$,$,(#45));
#48=IFCRELDEFINESBYPROPERTIES('6bB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#40),#47);
#49=IFCQUANTITYAREA('NetFloorArea',$,$,18.,$);
#50=IFCELEMENTQUANTITY('7bB1cD2eF3gH4iJ5kL6mN7',$,'Qto_SpaceBaseQuantities',$,$,(#49));
#51=IFCRELDEFINESBYPROPERTIES('8bB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#41),#50);
#52=IFCQUANTITYAREA('GrossFloorArea',$,$,40.,$);
#53=IFCELEMENTQUANTITY('9bB1cD2eF3gH4iJ5kL6mN7',$,'Qto_SpaceBaseQuantities',$,$,(#52));
#54=IFCRELDEFINESBYPROPERTIES('AbB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#42),#53);
#60=IFCPROPERTYSINGLEVALUE('YearOfConstruction',$,IFCLABEL('1962'),$);
#62=IFCPROPERTYSET('BbB1cD2eF3gH4iJ5kL6mN7',$,'Pset_BuildingCommon',$,(#60));
#63=IFCRELDEFINESBYPROPERTIES('CbB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#22),#62);
/* Four exterior walls, 300 mm thick and 3000 mm high, around a 10 m by 6 m ground floor: no base slab, so the footprint comes from them. */
#100=IFCWALL('1Wa0Ll1Ab2Cd3Ef4Gh5Ij1',$,'South wall',$,$,#25,#104,$,.SOLIDWALL.);
#101=IFCCARTESIANPOINT((5000.,150.));
#102=IFCRECTANGLEPROFILEDEF(.AREA.,$,#103,10000.,300.);
#103=IFCAXIS2PLACEMENT2D(#101,$);
#104=IFCPRODUCTDEFINITIONSHAPE($,$,(#105));
#105=IFCSHAPEREPRESENTATION(#12,'Body','SweptSolid',(#106));
#106=IFCEXTRUDEDAREASOLID(#102,#9,#7,3000.);
#110=IFCWALL('1Wa0Ll1Ab2Cd3Ef4Gh5Ij2',$,'North wall',$,$,#25,#114,$,.SOLIDWALL.);
#111=IFCCARTESIANPOINT((5000.,5850.));
#112=IFCRECTANGLEPROFILEDEF(.AREA.,$,#113,10000.,300.);
#113=IFCAXIS2PLACEMENT2D(#111,$);
#114=IFCPRODUCTDEFINITIONSHAPE($,$,(#115));
#115=IFCSHAPEREPRESENTATION(#12,'Body','SweptSolid',(#116));
#116=IFCEXTRUDEDAREASOLID(#112,#9,#7,3000.);
#120=IFCWALL('1Wa0Ll1Ab2Cd3Ef4Gh5Ij3',$,'West wall',$,$,#25,#124,$,.SOLIDWALL.);
#121=IFCCARTESIANPOINT((150.,3000.));
#122=IFCRECTANGLEPROFILEDEF(.AREA.,$,#123,300.,5400.);
#123=IFCAXIS2PLACEMENT2D(#121,$);
#124=IFCPRODUCTDEFINITIONSHAPE($,$,(#125));
#125=IFCSHAPEREPRESENTATION(#12,'Body','SweptSolid',(#126));
#126=IFCEXTRUDEDAREASOLID(#122,#9,#7,3000.);
#130=IFCWALL('1Wa0Ll1Ab2Cd3Ef4Gh5Ij4',$,'East wall',$,$,#25,#134,$,.SOLIDWALL.);
#131=IFCCARTESIANPOINT((9850.,3000.));
#132=IFCRECTANGLEPROFILEDEF(.AREA.,$,#133,300.,5400.);
#133=IFCAXIS2PLACEMENT2D(#131,$);
#134=IFCPRODUCTDEFINITIONSHAPE($,$,(#135));
#135=IFCSHAPEREPRESENTATION(#12,'Body','SweptSolid',(#136));
#136=IFCEXTRUDEDAREASOLID(#132,#9,#7,3000.);
#140=IFCPROPERTYSINGLEVALUE('IsExternal',$,IFCBOOLEAN(.T.),$);
#141=IFCPROPERTYSET('DbB1cD2eF3gH4iJ5kL6mN7',$,'Pset_WallCommon',$,(#140));
#142=IFCRELDEFINESBYPROPERTIES('EbB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#100,#110,#120,#130),#141);
#143=IFCRELCONTAINEDINSPATIALSTRUCTURE('FbB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#100,#110,#120,#130),#24);
/* The same mono-pitch roof slab, in millimetres. */
#80=IFCSLAB('3Rf0Sl1Ab2Cd3Ef4Gh5Ij7',$,'Roof',$,$,#28,#84,$,.ROOF.);
#82=IFCCARTESIANPOINTLIST3D(((0.,0.,3000.),(10000.,0.,3000.),(10000.,6000.,6464.102),(0.,6000.,6464.102)));
#83=IFCPOLYGONALFACESET(#82,$,(#85),$);
#84=IFCPRODUCTDEFINITIONSHAPE($,$,(#86));
#85=IFCINDEXEDPOLYGONALFACE((1,2,3,4));
#86=IFCSHAPEREPRESENTATION(#12,'Body','Tessellation',(#83));
#88=IFCRELCONTAINEDINSPATIALSTRUCTURE('IbB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#80),#26);
/* A tree in the garden. */
#90=IFCGEOGRAPHICELEMENT('0Tr1Ee2Ab3Cd4Ef5Gh6Ij8',$,'Lime tree',$,'tree',#21,$,$,.USERDEFINED.);
#92=IFCRELCONTAINEDINSPATIALSTRUCTURE('JbB1cD2eF3gH4iJ5kL6mN7',$,$,$,(#90),#20);
ENDSEC;
