ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView_V1.2]'),'2;1');
FILE_NAME('ifc-house-site-coordinates.ifc','2026-10-13T09:00:00',('Nexgen OS'),('Nexgen OS'),'hand-written','hand-written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Project, lengths in millimetres, no map conversion: true north is 30 degrees clockwise from the model's +Y, so the model's X axis is 30 degrees counter-clockwise from east. */
#1=IFCPROJECT('2HfKnNa8n0FwQvE3VQ6bdv',$,'Canal house',$,$,$,$,(#11),#5);
#2=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#3=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#4=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#5=IFCUNITASSIGNMENT((#2,#3,#4));
#6=IFCCARTESIANPOINT((0.,0.,0.));
#7=IFCDIRECTION((0.,0.,1.));
#9=IFCAXIS2PLACEMENT3D(#6,$,$);
#10=IFCDIRECTION((0.5,0.866025403784439));
#11=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#9,#10);
#12=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#11,$,.MODEL_VIEW.,$);
/* Site at 52 deg 22' 11.374355" N, 4 deg 53' 16.694753" E, ground at sea level: the point RD New calls (121000, 487000). */
#20=IFCSITE('1xS3BCk291UvhgP2dvNsgq',$,'Plot',$,$,#21,$,$,.ELEMENT.,(52,22,11,374355),(4,53,16,694753),0.,$,$);
#21=IFCLOCALPLACEMENT($,#9);
#22=IFCBUILDING('0K7w7JWBL5QOdBzu3Yz7Tt',$,'Canal house','A narrow house on a canal',$,#23,$,'Het Grachtenhuis',.ELEMENT.,$,$,$);
#23=IFCLOCALPLACEMENT(#21,#9);
#24=IFCBUILDINGSTOREY('3Tq9Gb8Hz7Rf2cW0aLmPkT',$,'00 Ground floor',$,$,#25,$,'Begane grond',.ELEMENT.,0.);
#25=IFCLOCALPLACEMENT(#23,#9);
#26=IFCBUILDINGSTOREY('1Nc4Tf6Uy0Hd8bQ2eVwXrK',$,'01 First floor',$,$,#28,$,'Eerste verdieping',.ELEMENT.,3000.);
#27=IFCAXIS2PLACEMENT3D(#29,$,$);
#28=IFCLOCALPLACEMENT(#23,#27);
#29=IFCCARTESIANPOINT((0.,0.,3000.));
#30=IFCRELAGGREGATES('0bB1cD2eF3gH4iJ5kL6mN7',$,$,$,#1,(#20));
