{
  "name": "@nexgen-os/ocpp",
  "version": "0.4.1",
  "description": "The Open Charge Point Protocol, OCPP 1.6J and 2.0.1: frames, station identity, connector states, meter values, sessions and charging profiles read into plain shapes and written back. No database, no dependency.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexgen-os/nexgen-os.git",
    "directory": "packages/formats/ocpp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
