{
  "name": "@nexgen-os/parquet",
  "version": "0.3.0",
  "description": "Series rows (series, instant, value, quality) written as a Parquet file in memory. No database.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexgen-os/nexgen-os.git",
    "directory": "packages/formats/parquet"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "hyparquet-writer": "0.16.13"
  }
}
