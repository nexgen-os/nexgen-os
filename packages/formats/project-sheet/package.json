{
  "name": "@nexgen-os/project-sheet",
  "version": "0.4.2",
  "description": "A project sheet — a project, its participants, their meters and devices as one CSV table a spreadsheet saves — read with its problems named, and written back. No database, no dependency.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexgen-os/nexgen-os.git",
    "directory": "packages/formats/project-sheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "template.csv",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  }
}
