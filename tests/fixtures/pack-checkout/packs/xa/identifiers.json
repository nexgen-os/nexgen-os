      "code": "xa_metering_point",
      "name": "Metering point number",
      "description": "Issued by the distribution operator of the connection.",
      "pattern": "^XA[0-9]{8}$",
      "example": "XA12345678"
    },
    {
      "code": "xa_municipality",
      "name": "Municipality code",
